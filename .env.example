# Fill in your internal OpenAI-compatible LLM endpoint and exact server model name.
# After editing .env, restart both API and Streamlit windows.
# Shell environment variables take precedence over this file.
# Empty GEMMA_API_URL means clearly labelled mock mode.
GEMMA_API_URL=
GEMMA_MODEL=
GEMMA_API_KEY=
GEMMA_TIMEOUT=120
GEMMA_MAX_TOKENS=2048

# RAG API and question UI (separate from the LLM API).
RAG_API_BASE=http://127.0.0.1:8000
RAG_API_TOKEN=
RAG_USER_GROUPS=all
RAG_QUERY_TIMEOUT=600

# Document processing
RAG_DOCS_DIR=data/docs
RAG_MD_DIR=data/md
RAG_ORIGINALS_DIR=data/originals
RAG_DB_PATH=data/rag.sqlite3
RAG_AUTOSCAN=1
RAG_SCAN_INTERVAL_MIN=30

# Optional: LibreOffice path for DOC/PPT conversion, use forward slashes.
# RAG_SOFFICE=C:/Program Files/LibreOffice/program/soffice.exe
# Optional: cpu, cuda, or auto
RAG_MODEL_DEVICE=auto

# Native Windows defaults; no Linux, Docker or Redis is required.
RAG_DB_BACKEND=sqlite
RAG_SEARCH_BACKEND=sqlite
RAG_TASK_BACKEND=native
# PostgreSQL requires OpenSearch. Set only after configuring a real internal server.
RAG_POSTGRES_DSN=
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=rag-chunks-v3
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_TLS=1
OPENSEARCH_CA_CERTS=
OPENSEARCH_TIMEOUT=30
RAG_REDIS_URL=redis://127.0.0.1:6379/0
RAG_REDIS_RESULT_URL=redis://127.0.0.1:6379/1
RAG_QUEUE_RECONCILE_SECONDS=60
RAG_QUEUE_RECONCILE_LIMIT=100
RAG_QUEUE_VISIBILITY_SECONDS=86400
RAG_JOB_LEASE_SECONDS=120
# Native worker renews long running job leases every 5 seconds.
# OCR runs on this same Windows RTX 5080 PC in its isolated .venv-ocr.
RAG_OCR_MODE=api
RAG_OCR_MODEL_DIR=models/unlimited-ocr
RAG_OCR_PYTHON_PATH=.venv-ocr/Scripts/python.exe
RAG_OCR_API_URL=http://127.0.0.1:10000/v1
RAG_OCR_API_KEY=
RAG_OCR_MODEL=Unlimited-OCR
RAG_OCR_TIMEOUT=1200
RAG_OCR_MAX_TOKENS=8192
RAG_OCR_CA_BUNDLE=
RAG_OCR_DPI=300
RAG_OCR_MAX_PIXELS=20000000

# Local runtime never needs to download models or send usage analytics.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
RAG_MANAGE_OCR=1
RAG_OCR_STARTUP_TIMEOUT=300
RAG_NATIVE_POLL_SECONDS=2
RAG_NATIVE_BATCH_SIZE=1
